FROM ubuntu:24.04

# Install dependencies
RUN apt-get update -y && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3 python3-pip wget curl tar jq gcc g++ make git ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Install Open Policy Agent (OPA)
RUN curl -L -o /usr/local/bin/opa https://openpolicyagent.org/downloads/v0.61.0/opa_linux_amd64_static && \
    chmod +x /usr/local/bin/opa

# Set up environment
WORKDIR /opt/quantum-flex

# We will mount the audit script and policies at runtime, 
# and the target repo at /mnt/target
CMD ["python3", "/opt/quantum-flex/qf_audit.py", "/mnt/target", "-o", "/mnt/target/qf-audit-output"]
