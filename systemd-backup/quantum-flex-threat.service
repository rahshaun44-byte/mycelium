[Unit]
Description=Quantum Flex Threat Ingestion Pipeline Service
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/USERNAME/.local/share/quantum-flex/bin/threat_processor.py /home/USERNAME/.local/share/quantum-flex
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
