[Unit]
Description=Quantum Flex Core API Gateway Node
After=network.target athena-node.service

[Service]
Type=simple
WorkingDirectory=/home/USERNAME/mycelium/api_node
ExecStart=/home/USERNAME/mycelium/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8002
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
