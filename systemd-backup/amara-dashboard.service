[Unit]
Description=A.M.A.R.A. Sync Dashboard
After=network.target ghost-node-agent.service

[Service]
Environment="TZ=America/New_York"
Type=simple
WorkingDirectory=/home/USERNAME/mycelium/amara
ExecStart=/home/USERNAME/mycelium/venv/bin/uvicorn dashboard:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5s
StandardOutput=append:%h/.local/state/amara/dashboard.log
StandardError=inherit

# Resource clamp — dashboard is a lightweight read layer
CPUQuota=15%
MemoryHigh=200M
MemoryMax=300M

[Install]
WantedBy=default.target
