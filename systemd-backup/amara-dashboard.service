[Unit]
Description=A.M.A.R.A. Sync Dashboard
After=network.target amara-matrix.service
Wants=amara-matrix.service

[Service]
Environment="TZ=America/New_York"
EnvironmentFile=/home/quant/mycelium/.env
Type=simple
WorkingDirectory=/home/quant/mycelium/amara
ExecStart=/home/quant/mycelium/venv/bin/uvicorn dashboard:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5s
StandardOutput=append:%h/.local/state/amara/dashboard.log
StandardError=inherit

CPUQuota=20%
MemoryHigh=250M
MemoryMax=350M

[Install]
WantedBy=default.target
