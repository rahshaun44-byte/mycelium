# ==============================================================================
# QuantumFlex Monotonic Witness Container (Quadlet Unit)
# ==============================================================================
# Independent external anti-rollback witness arbiter (Gate 5 / QF_EXTERNAL_CHECKPOINT_V1).
# Enforces monotonic sequence progression (sequence > highest_witnessed_sequence).
#
# HARDENING:
#   - Bound strictly to loopback (127.0.0.1:8444). Zero LAN/physical exposure.
#   - Rootless unprivileged execution (UID 10001).
#   - All capabilities dropped (DropCapability=ALL).
#   - Persistent SQLite WAL volume at /data.
# ==============================================================================

[Unit]
Description=QuantumFlex Monotonic Witness Container
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=quantumflex-witness
Image=localhost/quantumflex/monotonic-witness:latest
Network=host
Environment=WITNESS_BIND_ADDR=127.0.0.1:8444
Volume=%h/.local/share/quantum-flex-mycelium/witness:/data:Z
NoNewPrivileges=true
DropCapability=ALL

[Service]
Restart=on-failure
RestartSec=3
TimeoutStartSec=15

[Install]
WantedBy=default.target
