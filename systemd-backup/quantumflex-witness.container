# ==============================================================================
# QuantumFlex Monotonic Witness Container (Quadlet Template for HP Pavilion)
# ==============================================================================
# Dedicated external anti-rollback witness arbiter running on Worker Node 2
# (qf-pavilion-worker: 100.82.53.126).
#
# HARDENING:
#   - Bound strictly to the Tailscale interface IP (100.82.53.126:8444).
#   - Zero physical LAN exposure (never 0.0.0.0 or 192.168.0.79).
#   - Enforces strict monotonic sequence progression (seq > highest_witnessed).
#   - Integrates FIPS 204 ML-DSA and Ed25519 cryptographic provenance verification.
# ==============================================================================

[Unit]
Description=QuantumFlex Monotonic Witness Node (HP Pavilion)
After=network-online.target tailscaled.service
Wants=tailscaled.service

[Container]
ContainerName=qf-witness
Image=localhost/quantumflex/monotonic-witness:latest

# Use host networking so the container can bind directly to the tailscale0 interface IP
Network=host

Environment=WITNESS_BIND_ADDR=100.82.53.126:8444
Secret=postgres-telemetry-pass,type=env,target=POSTGRES_PASSWORD
Environment=POSTGRES_USER=qf_admin
Environment=POSTGRES_DB=telemetry
Environment=POSTGRES_TELEMETRY_URL=postgres://qf_admin:${POSTGRES_PASSWORD}@127.0.0.1:5432/telemetry?sslmode=disable

NoNewPrivileges=true
DropCapability=ALL

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=15

[Install]
WantedBy=default.target
