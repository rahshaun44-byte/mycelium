{
	// 1. Tag ownership definitions (for device tagging & exit nodes)
	"tagOwners": {
		"tag:host":      ["rahshaun44-byte@github", "autogroup:admin"],
		"tag:mobile":    ["rahshaun44-byte@github", "autogroup:admin"],
		"tag:exit-node": ["rahshaun44-byte@github", "autogroup:admin"],
	},

	// 2. Sovereign Node Hardware Identity Mappings
	"hosts": {
		"yoga":  "100.72.3.123",   // Lenovo Yoga 7 (Primary Host Engine, Local AI & DB)
		"pixel": "100.108.225.93",  // Google Pixel 11 Pro (Mobile Cockpit HUD & StrongBox Custodian)
	},

	// 3. Automatic route & exit-node approval (Zero-click admin approval)
	"autoApprovers": {
		"exitNode": ["tag:exit-node"],
	},

	// 4. Access control rules (Least-Privilege & Fail-Closed)
	"acls": [
		// Pixel 11 Pro -> Yoga 7: Tactical Cockpit, Web HUD, APIs & Operator SSH
		// Opens: Tailscale HTTPS Serve (443), Cockpit API (9001), QF-Bot (9000), Dashboard (8000), Gateway (8080), Command Center (8082), Ollama (11434), and SSH (22)
		// FAILS CLOSED against all unlisted ports: 5432, 5433, 8181, 9444 are completely invisible
		{
			"action": "accept",
			"src": [
				"pixel",
				"tag:mobile",
			],
			"dst": [
				"yoga:22",
				"yoga:443",
				"yoga:8000",
				"yoga:8080",
				"yoga:8082",
				"yoga:9000",
				"yoga:9001",
				"yoga:11434",
			],
		},

		// Yoga 7 -> Pixel 11 Pro: Wireless ADB debugging & cryptographic sync
		{
			"action": "accept",
			"src": [
				"yoga",
				"tag:host",
			],
			"dst": [
				"pixel:5555",
			],
		},

		// Exit Node Routing: Encrypts public Wi-Fi/5G traffic from mobile through Yoga 7
		{
			"action": "accept",
			"src": [
				"autogroup:member",
				"pixel",
			],
			"dst": [
				"autogroup:internet:*",
			],
		},
	],

	// 5. Tailscale SSH policy
	// Separates user self-SSH from tagged device SSH (autogroup:self requires autogroup:member src only)
	"ssh": [
		{
			"action": "accept",
			"src": [
				"autogroup:member",
			],
			"dst": [
				"tag:host",
				"autogroup:self",
			],
			"users": [
				"quant",
				"autogroup:nonroot",
				"root",
			],
		},
		{
			"action": "accept",
			"src": [
				"tag:mobile",
			],
			"dst": [
				"tag:host",
			],
			"users": [
				"quant",
				"autogroup:nonroot",
				"root",
			],
		},
	],

	// 6. Enforce strict policy tests on save (prevents accidental misconfigurations)
	"tests": [
		{
			"src": "pixel",
			"accept": [
				"yoga:22",
				"yoga:443",
				"yoga:8000",
				"yoga:8080",
				"yoga:8082",
				"yoga:9000",
				"yoga:9001",
				"yoga:11434",
			],
			"deny": [
				"yoga:5432",
				"yoga:5433",
				"yoga:8181",
				"yoga:9444",
			],
		},
		{
			"src": "yoga",
			"accept": [
				"pixel:5555",
			],
			"deny": [
				"pixel:22",
				"pixel:80",
				"pixel:443",
			],
		},
	],

	// 7. Node attributes
	"nodeAttrs": [
		{
			"target": ["autogroup:member"],
			"attr":   ["funnel"],
		},
	],
}
