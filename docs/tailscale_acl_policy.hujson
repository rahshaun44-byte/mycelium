{
	// Device IP definitions
	"hosts": {
		"yoga":  "100.72.3.123",   // Lenovo Yoga 7 (Primary Host Engine & Local AI)
		"pixel": "100.126.7.67",   // Google Pixel 11 Pro (Mobile HUD & StrongBox Sentinel)
		"g6":    "100.117.194.89",  // HP ProBook 450 G6 (Auxiliary / Kafka)
	},

	// Access control rules (Least-Privilege & Fail-Closed)
	"acls": [
		// 1. Pixel 11 Pro -> Yoga 7: QuantumFlex Mobile Cockpit & Operator SSH
		// Allows Tailscale HTTPS Serve (443), direct API (9001), and SSH (22)
		{
			"action": "accept",
			"src":    ["pixel"],
			"dst": [
				"yoga:22",
				"yoga:443",
				"yoga:9001",
			],
		},

		// 2. Yoga 7 -> HP ProBook G6: Operator SSH, RDP, and Kafka telemetry
		{
			"action": "accept",
			"src":    ["yoga"],
			"dst": [
				"g6:22",
				"g6:3389",
				"g6:8090",
				"g6:9092",
			],
		},

		// 3. Yoga 7 -> Pixel 11 Pro: Wireless ADB debugging
		{
			"action": "accept",
			"src":    ["yoga"],
			"dst": [
				"pixel:5555",
			],
		},
	],

	// Tailscale SSH rules: Allow tailnet members to SSH into their own devices
	"ssh": [
		{
			"action": "accept",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["quant", "autogroup:nonroot", "root"],
		},
	],

	// Enforce strict policy tests on save
	"tests": [
		{
			"src": "pixel",
			"accept": [
				"yoga:22",
				"yoga:443",
				"yoga:9001",
			],
			"deny": [
				"yoga:5432",
				"yoga:8000",
				"yoga:8080",
				"yoga:11434",
				"g6:22",
				"g6:9092",
			],
		},
		{
			"src": "yoga",
			"accept": [
				"g6:22",
				"g6:3389",
				"g6:8090",
				"g6:9092",
				"pixel:5555",
			],
			"deny": [
				"pixel:22",
				"pixel:80",
				"pixel:443",
			],
		},
		{
			"src": "g6",
			"deny": [
				"yoga:22",
				"yoga:443",
				"yoga:5432",
				"yoga:9001",
				"pixel:5555",
			],
		},
	],

	"nodeAttrs": [
		{
			"target": ["autogroup:member"],
			"attr":   ["funnel"],
		},
	],
}
