{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuantumFlexExperimentManifest",
  "type": "object",
  "required": [
    "manifest_id",
    "timestamp_utc",
    "experiment_type",
    "environment",
    "parameters",
    "computational_invariants",
    "execution_digest"
  ],
  "properties": {
    "manifest_id": { "type": "string" },
    "timestamp_utc": { "type": "string" },
    "experiment_type": { "type": "string" },
    "environment": {
      "type": "object",
      "required": ["os", "kernel", "cpu_model", "python_version", "compiler", "math_libraries"],
      "properties": {
        "os": { "type": "string" },
        "kernel": { "type": "string" },
        "cpu_model": { "type": "string" },
        "python_version": { "type": "string" },
        "compiler": { "type": "string" },
        "math_libraries": {
          "type": "object",
          "properties": {
            "numpy": { "type": "string" },
            "scipy": { "type": "string" },
            "qiskit": { "type": "string" },
            "sympy": { "type": "string" }
          }
        }
      }
    },
    "parameters": {
      "type": "object",
      "required": ["prng_seed", "float_precision", "solver", "tolerance"],
      "properties": {
        "prng_seed": { "type": "integer" },
        "float_precision": { "type": "string", "enum": ["IEEE_754_FLOAT64", "IEEE_754_FLOAT32", "ARBITRARY_MPMATH"] },
        "solver": { "type": "string" },
        "tolerance": {
          "type": "object",
          "properties": {
            "atol": { "type": "number" },
            "rtol": { "type": "number" }
          }
        }
      }
    },
    "computational_invariants": {
      "type": "array",
      "items": { "type": "string" }
    },
    "execution_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
