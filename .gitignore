# Quantum Flex Operational Exclusions
*.isolated
*.log
*.trace.json
*.flight_trace.json
api_threat.txt
api_env/
.env*
secrets.txt
*.pem
*.key
n8n/data/
__pycache__/

# Generated/runtime state — not source, churns on every run
sentinel/chroma_db/
sentinel/ledger/ledger.json
sentinel/bundle_server/
sentinel/intelligence/*.db
.tripwire/

# CMake build output — regenerated by `cmake -S . -B build_check`
build_check/
build/
compile_commands.json

# Compiled binaries and intermediates, including in-tree (non-build/) output.
# The MSVC in-source build drops sentinel_push.exe/.obj in the repo root, which
# `build/` does not cover — an entire build tree was accidentally committed once
# before. Keep these excluded rather than rely on remembering at `git add -A`.
*.exe
*.obj
*.dll
*.lib
*.pdb
*.ilk
*.exp

# Packaged release bundles — regenerated by the alpha-node packaging step.
# dist/ holds a ~22MB zip plus ~25 redistributable DLLs; it is build output,
# not source.
dist/

# Invalidated ceremony artifacts — no code path in this repo consumes
# Groth16/circom output (LocalNode's ZkCommitment is plain salted SHA-256).
# Regenerated more than once by sessions unaware it was already retired —
# keep this excluded rather than let it get committed again.
sentinel/ceremony/
*.ptau
*.zkey

# Excluded intentionally — do not re-add.
sentinel/neutralize.sh

# Generated release attestation artifacts
*.tar.gz
policy_evidence.json
release_attestation.json
